---
/**
 * One motion token: its curve, plotted from the CSS it ships, and a piece that moves with it on demand.
 */
interface Props {
  name: string
  duration: string
  easing: string
  description?: string
  bounce?: number
}

const { name, duration, easing, description, bounce } = Astro.props

/** Samples of the curve, 0–1 in time: read from linear() stops or computed from cubic-bezier() */
function sample(css: string): number[] {
  const linear = /^linear\((.*)\)$/.exec(css)
  if (linear) return linear[1].split(',').map(Number)
  const bezier = /^cubic-bezier\((.*)\)$/.exec(css)
  if (!bezier) return [0, 1]
  const [x1, y1, x2, y2] = bezier[1].split(',').map(Number)
  const at = (p1: number, p2: number, t: number) => 3 * (1 - t) ** 2 * t * p1 + 3 * (1 - t) * t ** 2 * p2 + t ** 3
  return Array.from({ length: 49 }, (_, i) => {
    const x = i / 48
    let [low, high] = [0, 1]
    for (let step = 0; step < 30; step++) {
      const mid = (low + high) / 2
      if (at(x1, x2, mid) < x) low = mid
      else high = mid
    }
    return at(y1, y2, (low + high) / 2)
  })
}

/* Written for reading, with a space before the unit: 320 ms */
const spaced = (value: string) => value.replace(/^(-?[\d.]+)(ms|s|px)$/, '$1 $2')
const points = sample(easing)
const [WIDTH, HEIGHT, TOP, BOTTOM] = [160, 96, 12, 84]
const scaleY = (v: number) => BOTTOM - v * (BOTTOM - TOP)
const path = points.map((v, i) => `${i ? 'L' : 'M'}${((i / (points.length - 1)) * WIDTH).toFixed(1)} ${scaleY(v).toFixed(1)}`).join(' ')
---

<article class="motion" style={`--duration: ${duration}; --easing: ${easing}`}>
  <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} aria-hidden="true">
    <line class="guide" x1="0" x2={WIDTH} y1={scaleY(1)} y2={scaleY(1)} />
    <line class="guide" x1="0" x2={WIDTH} y1={scaleY(0)} y2={scaleY(0)} />
    <path d={path} />
  </svg>
  <div class="about">
    <h3><code>{name}</code></h3>
    <p class="spec">{spaced(duration)}{bounce !== undefined && `, bounce ${bounce}`}</p>
    {description && <p class="description">{description}</p>}
  </div>
  <div class="track">
    <span class="piece" />
  </div>
  <button class="play" type="button" aria-label={`Play ${name}`}>Play</button>
</article>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.motion .play')) {
    button.addEventListener('click', () => {
      const motion = button.closest('.motion')!
      motion.toggleAttribute('data-moved')
    })
  }
</script>

<style>
  .motion {
    position: relative;
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    grid-template-areas:
      'curve about'
      'curve track';
    gap: var(--sonar-space-12) var(--sonar-space-24);
    align-items: center;
    padding: var(--sonar-space-20) var(--sonar-space-24);
    border-radius: var(--sonar-shape-corner-medium);
    background: var(--sonar-color-surface-card);
    box-shadow: var(--sonar-elevation-1);
  }

  svg {
    grid-area: curve;
    width: 160px;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--sonar-color-accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .guide {
    stroke: var(--sonar-color-divider);
    stroke-dasharray: 2 3;
  }

  .about {
    grid-area: about;
    padding-right: 72px;
  }

  h3 code {
    color: var(--sonar-color-text-strong);
    font: 500 12px/1.4 var(--sonar-font-family-mono);
    overflow-wrap: anywhere;
  }

  .spec {
    margin-top: var(--sonar-space-2);
    color: var(--sonar-color-text-default);
    font: var(--sonar-type-label-md);
    letter-spacing: var(--sonar-type-label-md-tracking);
  }

  .description {
    margin-top: var(--sonar-space-4);
    color: var(--sonar-color-text-secondary);
    font: var(--sonar-type-body-md);
  }

  .track {
    grid-area: track;
    position: relative;
    height: 24px;
    border-radius: var(--sonar-shape-corner-full);
    background: var(--sonar-color-surface-container-low);
    container-type: inline-size;
  }

  .piece {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 16px;
    height: 16px;
    border-radius: var(--sonar-shape-corner-full);
    background: var(--sonar-color-accent);
    transition: translate var(--duration) var(--easing);
  }

  /* Moves on the compositor: translate, measured in the track’s own width */
  [data-moved] .piece {
    translate: calc(100cqw - 24px) 0;
  }

  .play {
    position: absolute;
    top: var(--sonar-space-20);
    right: var(--sonar-space-24);
    min-height: 32px;
    padding: 0 var(--sonar-space-16);
    border: 1px solid var(--sonar-color-border-strong);
    border-radius: var(--sonar-shape-corner-full);
    background: none;
    color: var(--sonar-color-text-strong);
    font: var(--sonar-type-button);
    letter-spacing: var(--sonar-type-button-tracking);
    cursor: pointer;
  }

  .play:hover {
    background: var(--sonar-color-state-hover);
  }

  @container page (width < 608px) {
    .motion {
      grid-template-columns: 1fr;
      grid-template-areas: 'about' 'curve' 'track';
    }
  }
</style>
