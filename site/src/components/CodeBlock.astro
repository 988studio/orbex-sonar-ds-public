---
interface Props {
  code: string
  language: string
}

const { code, language } = Astro.props
---

<div class="code-block">
  <div class="bar">
    <span class="language">{language}</span>
    <button class="copy" type="button" data-code={code}>Copy</button>
  </div>
  <!-- Long lines scroll inside the block, never the page; while they do, the block takes focus so the keyboard can scroll it -->
  <pre data-language={language} data-scroll-region><code>{code}</code></pre>
</div>

<script>
  /* The clipboard API is refused in some embedded viewers and on pages served without HTTPS: the code is then copied
     from a selection, the way a person would */
  function copyBySelection(text: string) {
    const field = document.createElement('textarea')
    field.value = text
    field.setAttribute('readonly', '')
    field.style.cssText = 'position:fixed;inset:0 auto auto 0;width:1px;height:1px;opacity:0'
    document.body.append(field)
    field.select()
    const copied = document.execCommand('copy')
    field.remove()
    return copied
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.code-block .copy')) {
    button.addEventListener('click', async () => {
      const text = button.dataset.code ?? ''
      let copied = false
      try {
        await navigator.clipboard.writeText(text)
        copied = true
      } catch {
        copied = copyBySelection(text)
      }
      button.textContent = copied ? 'Copied' : 'Copy failed'
      setTimeout(() => (button.textContent = 'Copy'), 1600)
    })
  }
</script>

<style>
  /* A header bar holds the language and the copy button, so neither ever covers the code */
  .code-block {
    min-width: 0;
    max-width: var(--site-measure);
    border-radius: var(--sonar-shape-corner-medium);
    background: var(--sonar-color-surface-container-low);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sonar-space-6) var(--sonar-space-8) 0 var(--sonar-space-24);
  }

  .language {
    color: var(--sonar-color-text-tertiary);
    font: var(--sonar-type-label-sm);
    letter-spacing: var(--sonar-type-label-sm-tracking);
    text-transform: uppercase;
  }

  pre {
    /* One axis only: wide content scrolls sideways; nothing scrolls or bounces up and down */
    overflow: auto hidden;
    overscroll-behavior-x: contain;
    padding: var(--sonar-space-8) var(--sonar-space-24) var(--sonar-space-20);
    color: var(--sonar-color-text-strong);
    font: 400 13px/1.6 var(--sonar-font-family-mono);
  }

  pre:focus-visible {
    outline: var(--sonar-focus-width) solid var(--sonar-color-focus);
    outline-offset: calc(-1 * var(--sonar-focus-width));
    border-radius: 0 0 var(--sonar-shape-corner-medium) var(--sonar-shape-corner-medium);
  }

  code {
    font: inherit;
  }

  .copy {
    min-height: 32px;
    padding: 0 var(--sonar-space-12);
    border: 0;
    border-radius: var(--sonar-shape-corner-full);
    background: none;
    color: var(--sonar-color-text-secondary);
    font: var(--sonar-type-label-md);
    letter-spacing: var(--sonar-type-label-md-tracking);
    cursor: pointer;
    transition: background-color var(--sonar-motion-effects-fast-duration) var(--sonar-motion-effects-fast-easing);
  }

  .copy:hover {
    background: var(--sonar-color-state-hover);
    color: var(--sonar-color-text-strong);
  }

  .copy:focus-visible {
    outline: 2px solid var(--sonar-color-accent);
    outline-offset: 2px;
  }
</style>
