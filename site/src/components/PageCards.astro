---
/**
 * The pages of a section as cards: a section’s index, the home page, the component catalog. The whole card can be
 * clicked, but the link is the title alone, so a screen reader hears a short name and then the description.
 */
interface Props {
  items: { title: string; href: string; description?: string; meta?: string }[]
  /** Level of the card titles in the page’s outline */
  headingLevel?: 2 | 3
}

const { items, headingLevel = 3 } = Astro.props
const Heading = headingLevel === 2 ? 'h2' : 'h3'
---

<ul class="page-cards" role="list">
  {
    items.map(({ title, href, description, meta }) => (
      <li>
        <Heading class="title">
          <a href={href}>{title}</a>
        </Heading>
        {description && <p class="description">{description}</p>}
        <p class="foot">
          {meta && <span class="meta">{meta}</span>}
          <span class="arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12"><path d="M5 12h13M12 6l6 6-6 6" /></svg>
          </span>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .page-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--sonar-space-12);
    padding: 0;
  }

  li {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--sonar-space-6);
    padding: var(--sonar-space-16) var(--sonar-space-20) var(--sonar-space-16);
    border-radius: var(--sonar-shape-corner-large);
    background: var(--sonar-color-surface-card);
    box-shadow: var(--sonar-elevation-1);
    transition: box-shadow var(--sonar-motion-effects-default-duration) var(--sonar-motion-effects-default-easing);
  }

  li:has(a:hover) {
    box-shadow: var(--sonar-elevation-2);
  }

  li:has(a:focus-visible) {
    outline: var(--sonar-focus-width) solid var(--sonar-color-focus);
    outline-offset: var(--sonar-focus-offset);
  }

  .title {
    margin: 0;
    color: var(--sonar-color-text-strong);
    font: var(--sonar-type-title-md);
    letter-spacing: var(--sonar-type-title-md-tracking);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* The title’s link covers the card */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  a:focus-visible {
    outline: none;
  }

  .description {
    margin: 0;
    color: var(--sonar-color-text-secondary);
    font: var(--sonar-type-body-md);
    letter-spacing: var(--sonar-type-body-md-tracking);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: var(--sonar-space-6) 0 0;
  }

  .meta {
    color: var(--sonar-color-text-tertiary);
    font: var(--sonar-type-label-sm);
    letter-spacing: var(--sonar-type-label-sm-tracking);
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-left: auto;
    border-radius: var(--sonar-shape-corner-full);
    background: var(--sonar-color-accent);
    color: var(--sonar-color-on-accent);
    transition: translate var(--sonar-motion-spatial-fast-duration) var(--sonar-motion-spatial-fast-easing);
  }

  .arrow path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li:has(a:hover) .arrow {
      translate: 2px 0;
    }
  }
</style>
