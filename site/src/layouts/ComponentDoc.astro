---
/**
 * The page of one component: examples first, then guidance, accessibility, how to import it and its API.
 * The API and the weight come from the package build, never from copies.
 */
/* The site’s layer order first, so the components' layer comes after the reset */
import '../styles/global.css'
import '@orbex/sonar-components/styles.css'
import A11yTables from '../components/A11yTables.astro'
import CodeBlock from '../components/CodeBlock.astro'
import PageHeader from '../components/PageHeader.astro'
import PropsTable from '../components/PropsTable.astro'
import Section from '../components/Section.astro'
import DoDont from '../components/DoDont.astro'
import { componentEntry, formatWeight } from '../lib/components.ts'
import Docs from './Docs.astro'

interface Props {
  /** The page’s component: its slug under /components/ */
  entry: string
  lead: string
  /** Base UI reference page, for components built on it */
  baseUi?: string
}

const { entry, lead, baseUi } = Astro.props
const component = componentEntry(entry)
const { api, compound, imports, siblings } = component
const usage = `import { ${imports.join(', ')} } from '@orbex/sonar-components/${component.entry}'
import '@orbex/sonar-components/${component.entry}.css'`
---

<Docs title={component.title} description={`${component.title}, a component of the Orbex Sonar-DB Design System: examples, guidance, accessibility and API.`}>
  <PageHeader title={component.title} lead={lead}>
    <ul class="facts" role="list">
      <li>{api.behavior === 'native' ? 'Native HTML' : 'Behavior from Base UI'}</li>
      <li>{formatWeight(component.weight)} gzipped · script and styles</li>
      {siblings.length > 0 && <li>Shared with {siblings.join(', ')}</li>}
      <li><code>@orbex/sonar-components/{component.entry}</code></li>
    </ul>
  </PageHeader>

  <Section title="Examples" id="examples">
    <div class="demos"><slot /></div>
  </Section>

  {
    Astro.slots.has('specimens') && (
      <Section title="Sizes, variants and states" id="variants">
        <div class="demos">
          <slot name="specimens" />
        </div>
      </Section>
    )
  }

  <slot name="guidance" />

  <DoDont page={entry} />

  <Section title="Accessibility" id="accessibility">
    <A11yTables entry={entry} />
    <h3 class="notes">Notes</h3>
    <slot name="accessibility" />
  </Section>

  <Section title="Use it" id="use">
    <p class="prose">
      {siblings.length ? `${component.title} shares its entry point and stylesheet with ${siblings.join(', ')}.` : 'Each component is its own entry point with its own stylesheet, so an app loads only what it uses.'}
      {' '}The tokens and the cascade layers are set once for the app: see <a href="/get-started/installation/">Installation</a>.
    </p>
    <slot name="use" />
    <CodeBlock code={usage} language="tsx" />
  </Section>

  <Section title="API" id="api">
    {api.parts.map((part) => <PropsTable part={part} heading={compound || api.parts.length > 1 ? (compound ? `${api.name}.${part.name}` : part.name) : undefined} baseUi={baseUi} />)}
    <slot name="api" />
  </Section>
</Docs>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sonar-space-8);
    margin-top: var(--sonar-space-20);
    padding: 0;
  }

  .facts code {
    font: 500 11px/1 var(--sonar-font-family-mono);
  }

  /* Each fact is one chip on one line; chips wrap whole, and a chip wider than the page ends in an ellipsis */
  .facts li {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    box-sizing: border-box;
    height: 28px;
    padding: 0 var(--sonar-space-12);
    line-height: 28px;
    border-radius: var(--sonar-shape-corner-full);
    background: var(--sonar-color-surface-container);
    color: var(--sonar-color-text-default);
    font: var(--sonar-type-label-md);
    line-height: 28px;
    letter-spacing: var(--sonar-type-label-md-tracking);
  }

  .notes {
    margin: var(--sonar-space-28) 0 var(--sonar-space-8);
    font: var(--sonar-type-title-md);
    letter-spacing: var(--sonar-type-title-md-tracking);
  }

  .demos {
    display: grid;
    gap: var(--sonar-space-20);
  }
</style>
